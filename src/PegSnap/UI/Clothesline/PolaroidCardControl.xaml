<UserControl x:Class="PegSnap.UI.Clothesline.PolaroidCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="156" Height="122"
             RenderTransformOrigin="0.5, 0.0"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="Transparent"
             Cursor="Hand">
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            <RotateTransform x:Name="CardRotation" Angle="0"/>
            <TranslateTransform x:Name="CardTranslation" X="0" Y="0"/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <Grid Background="Transparent">
        <!-- Apple Minimalist Obsidian Frosted Card Base (macOS Dark Glass Style) -->
        <Border x:Name="CardBaseBorder"
                Width="150" Height="112"
                Margin="3,8,3,0"
                Background="#1E1E22"
                BorderBrush="#38383C" BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#000000" RenderingBias="Performance"/>
            </Border.Effect>
            <Grid Margin="5,5,5,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>

                <!-- 16:9 Razor-Sharp Viewport with Fast GPU Bilinear Scaling -->
                <Border Grid.Row="0"
                        Background="#121214"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Image x:Name="ThumbnailImage"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="Linear"/>
                </Border>

                <!-- Apple Style Minimalist Footer -->
                <Grid Grid.Row="1" Margin="2,2,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeLabel"
                                   Text="12:00"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="#8E8E93"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                        <TextBlock x:Name="DimensionsLabel"
                                   Text=" • 1920×1080"
                                   FontSize="8" FontWeight="Normal"
                                   Foreground="#636366"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                    </StackPanel>

                    <!-- Dedicated Copy Button (Apple subtle dark pill) -->
                    <Button x:Name="CopyButton"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#2C2C2E" Foreground="#0A84FF"
                            BorderThickness="0"
                            Padding="6,2" Cursor="Hand"
                            ToolTip="Salin ke Clipboard"
                            Click="OnCopyButtonClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="8" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copy" FontSize="8" FontWeight="SemiBold" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="#0A84FF"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Minimalist Apple Space-Gray Magnetic Pin (Titanium & Specular Dot) -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Width="18" Height="18" Margin="0,-1,0,0">
            <!-- Space Gray Brushed Aluminum Pin -->
            <Border Width="14" Height="14" CornerRadius="7"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#3A3A3C" BorderThickness="0.8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8E8E93" Offset="0.0"/>
                        <GradientStop Color="#636366" Offset="0.5"/>
                        <GradientStop Color="#48484A" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                </Border.Effect>
                <!-- Subtle Specular Dot -->
                <Ellipse Width="4" Height="4" Fill="#E5E5EA" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Minimalist Delete (X) on Hover -->
            <Button x:Name="CloseButton"
                    Width="14" Height="14"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#FF453A" Foreground="#FFFFFF"
                    BorderThickness="0"
                    FontSize="8" FontWeight="Bold"
                    Cursor="Hand"
                    Content="✕"
                    Opacity="0"
                    ToolTip="Hapus snap ini">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
