<UserControl x:Class="PegSnap.UI.Clothesline.TextCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="156" Height="122"
             RenderTransformOrigin="0.5,0.03"
             Background="Transparent"
             Cursor="Hand"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave">
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            <RotateTransform x:Name="CardRotation" Angle="0"/>
            <TranslateTransform x:Name="CardTranslation" X="0" Y="0"/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <Grid x:Name="RootContainer" Background="Transparent">
        <!-- Dark Glass Card Body (Matches PolaroidCardControl aesthetic) -->
        <Border x:Name="CardFrame"
                Margin="0,12,0,0"
                Background="#E61C1C20"
                BorderBrush="#3A3A40"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,9,10,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Header: Smart Category Pill + Swatch + Char Count -->
                <Grid Grid.Row="0" Margin="0,0,0,5" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border x:Name="CategoryBadge" Background="#200A84FF" BorderBrush="#400A84FF" BorderThickness="1"
                                CornerRadius="5" Padding="5,1">
                            <TextBlock x:Name="CategoryText" Text="CLIP" FontSize="8.5" FontWeight="Bold" Foreground="#5AC8FA"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                        </Border>
                        <Border x:Name="ColorSwatch" Width="11" Height="11" CornerRadius="5.5"
                                Margin="5,0,0,0" BorderBrush="#80FFFFFF" BorderThickness="1"
                                Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="CharCountText" Text="0 chars" FontSize="8.5" Foreground="#8E8E93"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                </Grid>

                <!-- Text Snippet Preview -->
                <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="6" Padding="7,5" ClipToBounds="True" IsHitTestVisible="False">
                    <TextBlock x:Name="PreviewTextBlock"
                               Text=""
                               Foreground="#E5E5EA"
                               FontSize="10.5"
                               LineHeight="14"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                </Border>

                <!-- Subtle bottom hint -->
                <TextBlock x:Name="HintText" Grid.Row="2" Text="Click card to copy"
                           FontSize="8.5" Foreground="#636366" Margin="0,4,0,0"
                           HorizontalAlignment="Center" IsHitTestVisible="False"
                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>

                <!-- Hover Remove Button (Top-Right over card) -->
                <StackPanel x:Name="HoverActions" Grid.RowSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-2,-2,0"
                            Opacity="0" IsHitTestVisible="False">
                    <Button x:Name="RemoveBtn" Width="22" Height="22"
                            ToolTip="Remove" Click="OnRemoveClicked" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBg" Background="#3A3A3C" CornerRadius="11">
                                    <TextBlock Text="✕" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBg" Property="Background" Value="#FF453A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Wooden Clothespin at top center -->
        <Grid Width="16" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" IsHitTestVisible="False">
            <Border Width="11" Height="22" CornerRadius="3" BorderBrush="#8B6538" BorderThickness="0.8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#C99E67" Offset="0"/>
                        <GradientStop Color="#E6C28E" Offset="0.5"/>
                        <GradientStop Color="#B58952" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
            </Border>
            <!-- Metal spring wire -->
            <Rectangle Width="13" Height="2.5" Fill="#A1A1A6" VerticalAlignment="Center" Margin="0,2,0,0" RadiusX="1" RadiusY="1"/>
        </Grid>
    </Grid>
</UserControl>

