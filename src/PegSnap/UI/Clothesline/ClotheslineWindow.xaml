<Window x:Class="PegSnap.UI.Clothesline.ClotheslineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clothey Clothesline"
        Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Grid x:Name="RootGrid">
        <!-- Subtle top-edge pill indicator when Auto-Hidden (non-hit-testable so clicks pass through) -->
        <Border x:Name="AutoHideHandle"
                Width="68" Height="3.5"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,1,0,0"
                CornerRadius="2"
                Background="#90E5E5EA"
                Opacity="0.45"
                IsHitTestVisible="False"/>

        <!-- Floating Multi-Monitor Clothesline Canvas -->
        <Canvas x:Name="RopeCanvas">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="AutoHideTransform" Y="-360"/>
            </Canvas.RenderTransform>
            <!-- Apple Minimalist Braided Cable across all monitors -->
            <Path x:Name="RopePath" StrokeThickness="2">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#408E8E93" Offset="0.0"/>
                        <GradientStop Color="#90D1D1D6" Offset="0.5"/>
                        <GradientStop Color="#408E8E93" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Stroke>
                <Path.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                </Path.Effect>
                <Path.Data>
                    <PathGeometry x:Name="RopePathGeometry"/>
                </Path.Data>
            </Path>

            <!-- Cards Container Canvas -->
            <Canvas x:Name="CardsCanvas" Canvas.Left="0" Canvas.Top="0" Height="360"/>

            <!-- Apple Dynamic Island Toast Banner -->
            <Border x:Name="ToastBanner" Canvas.Top="12" Canvas.Left="400"
                    Background="#1C1C1E" BorderBrush="#38383A" BorderThickness="1"
                    CornerRadius="18" Padding="14,6"
                    Opacity="0" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="📋" FontSize="13" Foreground="#0A84FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ToastMessage" Text="Copied to Clipboard" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                </StackPanel>
            </Border>

            <!-- Controls (Placed on the LEFT: Top-right is 100% CLEAR for closing other windows!) -->
            <StackPanel x:Name="TopControlsPanel" Orientation="Horizontal" Canvas.Top="8" Canvas.Left="20">
                <!-- Count Badge (Apple Control Center Capsule) -->
                <Border x:Name="CountBadge" Background="#242426" BorderBrush="#38383A" BorderThickness="1"
                        CornerRadius="12" Padding="8,4" Margin="0,0,6,0" Visibility="Collapsed">
                    <TextBlock x:Name="CountText" Text="0 snaps" FontSize="10.5" FontWeight="SemiBold" Foreground="#8E8E93"
                               FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                </Border>

                <!-- Clear All Button (Apple Subtle Pill) -->
                <Button x:Name="ClearAllBtn"
                        Background="#2C2C2E" Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="10,4" Margin="0,0,8,0"
                        FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" ToolTip="Bersihkan semua jemuran"
                        Visibility="Collapsed"
                        Click="OnClearAllClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear" Foreground="#E5E5EA" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#FF453A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
