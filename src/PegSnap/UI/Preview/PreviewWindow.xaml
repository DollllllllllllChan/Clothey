<Window x:Class="PegSnap.UI.Preview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clothey Quick Look"
        Width="960" Height="680"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewMouseWheel="OnWindowPreviewMouseWheel">
    
    <!-- Outer Window DropShadow Container -->
    <Border Margin="16"
            Background="#18181B"
            BorderBrush="#2C2C2E"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="12" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <!-- macOS Titlebar -->
                <RowDefinition Height="46"/>
                <!-- Viewport Canvas -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- macOS Top Titlebar -->
            <Grid Grid.Row="0" Background="#202024" MouseLeftButtonDown="OnTitleBarMouseDown">
                <!-- macOS Traffic Light Window Controls (Left) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Close (Red) -->
                    <Button Width="13" Height="13" Margin="0,0,8,0" Cursor="Hand" Click="OnCloseClicked" ToolTip="Tutup (Esc / Space)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Dot" Background="#FF5F56" BorderBrush="#E0443E" BorderThickness="0.6" CornerRadius="6.5">
                                    <TextBlock x:Name="Glyph" Text="✕" FontSize="7.5" FontWeight="Bold" Foreground="#4D0000"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Dot" Property="Background" Value="#FF6961"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Minimize (Yellow) -->
                    <Button Width="13" Height="13" Margin="0,0,8,0" Cursor="Hand" Click="OnMinimizeClicked" ToolTip="Minimize / Kembali ke Jemuran">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Dot" Background="#FFBD2E" BorderBrush="#DEA123" BorderThickness="0.6" CornerRadius="6.5">
                                    <TextBlock x:Name="Glyph" Text="−" FontSize="9" FontWeight="Bold" Foreground="#593B00"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Visibility="Collapsed"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Dot" Property="Background" Value="#FFC740"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Maximize / Restore (Green) -->
                    <Button Width="13" Height="13" Cursor="Hand" Click="OnZoomToggleClicked" ToolTip="Maximize / Restore">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Dot" Background="#27C93F" BorderBrush="#1AAB29" BorderThickness="0.6" CornerRadius="6.5">
                                    <TextBlock x:Name="Glyph" Text="⤢" FontSize="8" FontWeight="Bold" Foreground="#004D11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Dot" Property="Background" Value="#32D74B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Center Title & Metadata (San Francisco Style) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Prev Card Button -->
                    <Button x:Name="PrevButton" Content="◀" Width="22" Height="22" Margin="0,0,8,0" Cursor="Hand" Click="OnPrevClicked" ToolTip="Sebelumnya (Panah Kiri)" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="#2C2C2E" CornerRadius="11">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="8.5" FontWeight="Bold" Foreground="#8E8E93"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#3A3A3C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Clothey Quick Look" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                               FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                    <TextBlock x:Name="IndexSeparator" Text="  •  " FontSize="11" Foreground="#636366" Visibility="Collapsed"/>
                    <TextBlock x:Name="IndexCounterText" Text="1 of 3" FontSize="11" FontWeight="SemiBold" Foreground="#0A84FF" Visibility="Collapsed"
                               FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                    <TextBlock Text="  •  " FontSize="11" Foreground="#636366"/>
                    <TextBlock x:Name="DimensionsText" Text="1920 × 1080 px" FontSize="11" Foreground="#8E8E93"
                               FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                    <TextBlock Text="  •  " FontSize="11" Foreground="#636366"/>
                    <TextBlock x:Name="ZoomLevelText" Text="100%" FontSize="11" FontWeight="SemiBold" Foreground="#0A84FF"
                               FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>

                    <!-- Next Card Button -->
                    <Button x:Name="NextButton" Content="▶" Width="22" Height="22" Margin="8,0,0,0" Cursor="Hand" Click="OnNextClicked" ToolTip="Berikutnya (Panah Kanan)" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="#2C2C2E" CornerRadius="11">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="8.5" FontWeight="Bold" Foreground="#8E8E93"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#3A3A3C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Right Quick Zoom Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="−" Width="26" Height="24" Margin="0,0,4,0" Cursor="Hand" Click="OnZoomOutClicked" ToolTip="Zoom Out">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="#2C2C2E" CornerRadius="5">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold" Foreground="#8E8E93"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#3A3A3C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="FitButton" Content="Fit" Width="34" Height="24" Margin="0,0,4,0" Cursor="Hand" Click="OnZoomFitClicked" ToolTip="Fit to Window">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="#2C2C2E" CornerRadius="5">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E5E5EA"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#3A3A3C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="+" Width="26" Height="24" Cursor="Hand" Click="OnZoomInClicked" ToolTip="Zoom In">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="#2C2C2E" CornerRadius="5">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold" Foreground="#8E8E93"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#3A3A3C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Interactive Image Viewport (Row 1) -->
            <Grid x:Name="ViewportContainer"
                  Grid.Row="1"
                  Background="#111113"
                  ClipToBounds="True"
                  Focusable="True"
                  Cursor="Hand"
                  MouseLeftButtonDown="OnImageMouseDown"
                  MouseLeftButtonUp="OnImageMouseUp"
                  MouseMove="OnImageMouseMove"
                  MouseRightButtonDown="OnImageRightButtonDown"
                  PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <!-- Interactive Pan & Zoom Canvas -->
                <Grid x:Name="ViewportGrid"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                            <TranslateTransform x:Name="ImagePan" X="0" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border CornerRadius="8" ClipToBounds="True" Background="#161618">
                        <Grid x:Name="ImageCanvasContainer">
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   SnapsToDevicePixels="True"/>
                            <Canvas x:Name="AnnotationCanvas"
                                    Background="Transparent"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Floating macOS Annotation Toolbar (Top Center) -->
                <Border x:Name="AnnotationToolbar"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,12,0,0"
                        Background="#E6252528"
                        BorderBrush="#38383A"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="8,5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ToolPanBtn" Content="✋" Width="28" Height="26" Margin="0,0,3,0"
                                Cursor="Hand" ToolTip="Pan / Move" Click="OnToolSelected" Tag="Pan">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="#0A84FF" CornerRadius="10">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ToolPenBtn" Content="✏️" Width="28" Height="26" Margin="0,0,3,0"
                                Cursor="Hand" ToolTip="Pencil (Freehand)" Click="OnToolSelected" Tag="Pen">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="Transparent" CornerRadius="10">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#3A3A3C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ToolLineBtn" Content="╱" Width="28" Height="26" Margin="0,0,3,0"
                                Cursor="Hand" ToolTip="Line" Click="OnToolSelected" Tag="Line">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="Transparent" CornerRadius="10">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="Bold" Foreground="#E5E5EA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#3A3A3C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ToolRectBtn" Content="▭" Width="28" Height="26" Margin="0,0,3,0"
                                Cursor="Hand" ToolTip="Rectangle" Click="OnToolSelected" Tag="Rect">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="Transparent" CornerRadius="10">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="Bold" Foreground="#E5E5EA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#3A3A3C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ToolEraseBtn" Content="🧹" Width="28" Height="26" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Eraser (Click/drag over strokes)" Click="OnToolSelected" Tag="Erase">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="Transparent" CornerRadius="10">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#3A3A3C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="1" Height="16" Background="#3A3A3E" Margin="0,0,6,0"/>

                        <!-- Color Swatches -->
                        <Button x:Name="ColorRedBtn" Width="18" Height="18" Margin="0,0,4,0" Cursor="Hand" Click="OnColorSelected" Tag="#FF453A" ToolTip="Red">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FF453A" CornerRadius="9" BorderBrush="#FFFFFF" BorderThickness="1.8"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ColorYellowBtn" Width="18" Height="18" Margin="0,0,4,0" Cursor="Hand" Click="OnColorSelected" Tag="#FFD60A" ToolTip="Yellow">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FFD60A" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1.8"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ColorBlueBtn" Width="18" Height="18" Margin="0,0,4,0" Cursor="Hand" Click="OnColorSelected" Tag="#0A84FF" ToolTip="Blue">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#0A84FF" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1.8"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ColorGreenBtn" Width="18" Height="18" Margin="0,0,4,0" Cursor="Hand" Click="OnColorSelected" Tag="#30D158" ToolTip="Green">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#30D158" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1.8"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ColorWhiteBtn" Width="18" Height="18" Margin="0,0,6,0" Cursor="Hand" Click="OnColorSelected" Tag="#FFFFFF" ToolTip="White">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FFFFFF" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1.8"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="1" Height="16" Background="#3A3A3E" Margin="0,0,6,0"/>

                        <!-- Stroke Width Cycle -->
                        <Button x:Name="StrokeWidthBtn" Content="M" Width="26" Height="24" Margin="0,0,4,0"
                                Cursor="Hand" ToolTip="Stroke Thickness (S / M / L)" Click="OnCycleStrokeWidth">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="#333336" CornerRadius="8">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" FontWeight="Bold" Foreground="#E5E5EA"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#444448"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Undo (Ctrl+Z) -->
                        <Button Content="↩" Width="26" Height="24" Margin="0,0,4,0"
                                Cursor="Hand" ToolTip="Undo (Ctrl+Z)" Click="OnUndoClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="#333336" CornerRadius="8">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="#E5E5EA"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#444448"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Clear Annotations -->
                        <Button Content="🗑" Width="26" Height="24"
                                Cursor="Hand" ToolTip="Clear All Annotations" Click="OnClearAnnotationsClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="#333336" CornerRadius="8">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="11" Foreground="#E5E5EA"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#FF453A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Floating Apple Notification Pill (Toast) -->
                <Border x:Name="NotificationPill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,56,0,0"
                        Background="#1C1C1E"
                        BorderBrush="#38383A"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16,7"
                        Opacity="0"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NotificationIcon" Text="✓" FontSize="13" FontWeight="Bold" Foreground="#0A84FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NotificationText" Text="Copied to Clipboard" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                    </StackPanel>
                </Border>

                <!-- Floating macOS Action Pill (Bottom Center) -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Background="#252528"
                        BorderBrush="#38383A"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="8,5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.4" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel Orientation="Horizontal">
                        <!-- Primary Copy Button (Apple Blue Pill) -->
                        <Button x:Name="CopyBtn"
                                Background="#0A84FF" Foreground="#FFFFFF"
                                BorderThickness="0"
                                Padding="14,6" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Salin ke Clipboard (Ctrl+C)"
                                Click="OnCopyClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy Image" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#0071E3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Save As Button (Apple Dark Capsule) -->
                        <Button Background="#333336" Foreground="#E5E5EA"
                                BorderThickness="0"
                                Padding="12,6" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Simpan Gambar (Ctrl+S)"
                                Click="OnSaveClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Save As" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#444448"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Extract OCR Button (Apple Live Text) -->
                        <Button Background="#333336" Foreground="#E5E5EA"
                                BorderThickness="0"
                                Padding="12,6" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Ekstrak Teks OCR"
                                Click="OnOcrClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Live Text" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#444448"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Open With Default App -->
                        <Button Background="#333336" Foreground="#E5E5EA"
                                BorderThickness="0"
                                Padding="12,6" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Buka di Aplikasi Gambar Default"
                                Click="OnOpenInAppClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↗" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#444448"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close Button -->
                        <Button Background="#333336" Foreground="#E5E5EA"
                                BorderThickness="0"
                                Padding="12,6"
                                Cursor="Hand" ToolTip="Tutup (Esc)"
                                Click="OnCloseClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Done" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#444448"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
