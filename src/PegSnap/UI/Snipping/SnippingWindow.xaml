<Window x:Class="PegSnap.UI.Snipping.SnippingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clothey Snipping Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Cursor="Cross">
    <Canvas x:Name="OverlayCanvas" Background="#33000000">
        <!-- Apple Dynamic Island Style Instruction Banner -->
        <Border x:Name="BannerBorder" Canvas.Top="20" Canvas.Left="0"
                HorizontalAlignment="Center"
                Background="#1C1C1E" BorderBrush="#38383A" BorderThickness="1"
                CornerRadius="18" Padding="16,7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✂" FontSize="13" Foreground="#0A84FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="BannerText" Text="Drag cursor to snip selection  •  Press ESC to cancel"
                           FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
            </StackPanel>
        </Border>

        <!-- macOS Style Minimalist Selection Box -->
        <Border x:Name="SelectionBox"
                BorderBrush="#0A84FF" BorderThickness="1.5"
                Background="#180A84FF" CornerRadius="2"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#000000" Opacity="0.35"/>
            </Border.Effect>
        </Border>

        <!-- macOS Style Dimension Pill -->
        <Border x:Name="DimensionPill"
                Background="#1C1C1E" BorderBrush="#38383A" BorderThickness="1"
                CornerRadius="6" Padding="8,3"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <TextBlock x:Name="DimensionText"
                       Text="0 × 0 px"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
        </Border>
    </Canvas>
</Window>
